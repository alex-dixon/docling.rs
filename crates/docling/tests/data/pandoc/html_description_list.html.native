                , Space
                , Str "readability"
                ]
            ]
          ]
      ]
    , [ Plain [ Strong [ Str "JavaScript" ] ]
      , BulletList
          [ [ Plain
                [ Str "A"
                , Space
                , Str "scripting"
                , Space
                , Str "language"
                , Space
                , Str "for"
                , Space
                , Str "web"
                , Space
                , Str "browsers"
                ]
            ]
          ]
      ]
    ]
, Header
    2 ( "" , [] , [] ) [ Str "Complex" , Space , Str "Example" ]
, BulletList
    [ [ Plain [ Strong [ Str "HTML" ] ]
      , BulletList
          [ [ Plain
                [ Str "HyperText"
                , Space
                , Str "Markup"
                , Space
                , Str "Language"
                , Space
                , Str "-"
                , Space
                , Str "used"
                , Space
                , Str "for"
                , Space
                , Emph [ Str "structuring" ]
                , Space
                , Str "web"
                , Space
                , Str "content"
                ]
            ]
          ]
      ]
    , [ Plain [ Strong [ Str "CSS" ] ]
