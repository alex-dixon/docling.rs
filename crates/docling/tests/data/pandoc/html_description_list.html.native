[ Header 1 ( "" , [] , [] ) [ Str "Beverages" ]
, BulletList
    [ [ Plain [ Strong [ Str "Coffee" ] ]
      , BulletList
          [ [ Plain
                [ Str "Black"
                , Space
                , Str "hot"
                , Space
                , Str "drink"
                ]
            ]
          ]
      ]
    , [ Plain [ Strong [ Str "Milk" ] ]
      , BulletList
          [ [ Plain
                [ Str "White"
                , Space
                , Str "cold"
                , Space
                , Str "drink"
                ]
            ]
          ]
      ]
    , [ Plain [ Strong [ Str "Soda" ] ] ]
    , [ Plain [ Strong [ Str "Water" ] ] ]
    ]
, Header
    2
    ( "" , [] , [] )
    [ Str "Programming" , Space , Str "Languages" ]
, BulletList
    [ [ Plain [ Strong [ Str "Python" ] ]
      , BulletList
          [ [ Plain
                [ Str "A"
                , Space
                , Str "high-level"
                , Space
