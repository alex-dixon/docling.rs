                , Space
                , Str "styling"
                , Space
                , Str "and"
                , Space
                , Str "layout"
                ]
            ]
          ]
      ]
    ]
, Header
    2 ( "" , [] , [] ) [ Str "Nested" , Space , Str "Lists" ]
, BulletList
    [ [ Plain
          [ Strong
              [ Str "Main" , Space , Str "Term" , Space , Str "1" ]
          ]
      , BulletList
          [ [ Plain
                [ Str "Description"
                , Space
                , Str "for"
                , Space
                , Str "the"
                , Space
                , Str "first"
                , Space
                , Str "main"
                , Space
                , Str "term."
                ]
            ]
          ]
      ]
    , [ Plain
          [ Strong
              [ Str "Main"
              , Space
              , Str "Term"
              , Space
              , Str "2"
              , Space
              , Str "(Sub-categories)"
              ]
          ]
      , BulletList
          [ [ Plain [ Strong [ Str "Sub-term" , Space , Str "A" ] ]
            , BulletList
                [ [ Plain
                      [ Str "Detail"
                      , Space
                      , Str "for"
                      , Space
                      , Str "sub-term"
                      , Space
                      , Str "A."
                      ]
                  ]
                ]
            ]
          , [ Plain [ Strong [ Str "Sub-term" , Space , Str "B" ] ]
            , BulletList
                [ [ Plain
                      [ Str "Detail"
                      , Space
                      , Str "for"
                      , Space
                      , Str "sub-term"
                      , Space
                      , Str "B."
                      ]
                  ]
                ]
            ]
          ]
      ]
    , [ Plain
          [ Strong
              [ Str "Main"
              , Space
              , Str "Term"
              , Space
              , Str "3"
              , Space
              , Str "(Mixed)"
              ]
          ]
      , BulletList
          [ [ Plain
                [ Str "This"
                , Space
